# Crucible secrets — copy to `.env` (gitignored) and fill in.
# Only API keys and other secrets belong here. Non-secret model/tracing config
# goes in `config.yaml` (see config.yaml.example).

# --- OpenRouter (issue #80: the only LLM provider Crucible talks to) ---
# One key, any hosted model. Which model each role uses is set in
# config.yaml (see config.yaml.example) or CRUCIBLE_MODEL_<ROLE> below.
OPENROUTER_API_KEY=

# CRUCIBLE_MODEL_RECON=qwen/qwen-2.5-72b-instruct
# CRUCIBLE_MODEL_HUNTER=deepseek/deepseek-chat-v3.1

# --- Optional: LangSmith tracing (specs.md §13) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crucible
