# Crucible secrets — copy to `.env` (gitignored) and fill in.
# Only API keys and other secrets belong here. Non-secret model/tracing config
# goes in `config.yaml` (see config.yaml.example).

# --- LLM providers (set the key for whichever provider(s) you route roles to) ---
# OpenRouter: one key, any hosted model.
OPENROUTER_API_KEY=

# DeepSeek (hosted, OpenAI-compatible).
DEEPSEEK_API_KEY=

# --- Which provider each role uses (also settable in config.yaml) ---
# ollama | deepseek | openrouter
RECON_LLM=ollama
HUNTER_LLM=ollama

# --- Optional: LangSmith tracing (specs.md §13) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crucible
