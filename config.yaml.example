# Crucible configuration — copy to `config.yaml` (gitignored) and edit.
#
# NON-SECRET config only. The API key stays in the environment / a gitignored `.env`:
#   OPENROUTER_API_KEY, LANGSMITH_API_KEY
#
# Precedence (low -> high): built-in defaults  <  crucible.toml  <  config.yaml
#                           <  environment variables  <  per-run override
# `crucible run --config <path>` overrides auto-discovery (format by suffix).

# --- Model matrix: one model per agent role --------------------------------
# Every role is OpenRouter (issue #80) — no `provider` field. `model` must be
# one of the curated ids in crucible/llm/catalog.py (DeepSeek + Qwen, for now;
# also served over the API at GET /config/catalog).
# Hunter and validator_bug models MUST differ (specs.md §6).
models:
  recon:
    model: qwen/qwen-2.5-72b-instruct
    temperature: 0.1
  hunter:
    model: deepseek/deepseek-chat-v3.1
    temperature: 0.3
  validator_bug:
    model: qwen/qwen3-32b
    temperature: 0.1
  validator_reach:
    model: deepseek/deepseek-r1-0528
    temperature: 0.1
  # base_url: optional; omit to use https://openrouter.ai/api/v1

# --- Tracing toggles (specs.md §13) ---------------------------------------
# Enables spans; the API key itself is still read from the environment.
tracing:
  langsmith:
    enabled: false
    project: crucible
    # endpoint: https://api.smith.langchain.com   # or eu./apac.
  otel:
    enabled: false
    endpoint: http://localhost:4318
